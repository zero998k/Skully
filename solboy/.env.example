# 1) Make a free account at https://www.helius.dev, copy your API key,
#    and paste it in place of YOUR_KEY on BOTH lines below.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# 2) Only needed for LIVE mode. Run "npm run new-wallet" to create a burner wallet.
#    Never put your main wallet's key here.
PRIVATE_KEY=

# Optional: a free Jupiter key from https://portal.jup.ag (only if swaps fail without one)
JUPITER_API_KEY=

# Optional: Telegram alerts (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
