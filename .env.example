# Copy this file to .env and fill it in. Never share or commit .env!

# --- Required ---------------------------------------------------------------
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# At least ONE free AI key. Gemini is the smartest free option (and can see images):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional backups (also free) -------------------------------------------
# When one hits its free limit, the bot switches to the next automatically.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Run your own model with Ollama (free, needs a decent PC):
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_MODELS=qwen3:14b
# CUSTOM_LLM_VISION=false

# Free CoinGecko "Demo" key raises the crypto rate limit: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# --- Tweaks (defaults are fine) ---------------------------------------------
# BOT_NAME=Skully
# Extra personality/instructions, e.g. "Talk like a pirate. Zippe's favourite coin is PEPE."
# EXTRA_PERSONALITY=
# Which provider to try first:
# PROVIDER_ORDER=gemini,groq,openrouter,custom
# Models to prefer, best first (the bot skips ones that don't exist):
# GEMINI_MODELS=gemini-3-flash,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
# OPENROUTER_MODELS=openrouter/free
# How hard the model thinks: low / medium / high
# REASONING_EFFORT=high
# How many recent channel messages the bot reads for context:
# HISTORY_MESSAGES=20
# Show the little "🔎 searched ..." line under answers:
# SHOW_TOOL_TRACE=true
# DATABASE_PATH=skully.db
